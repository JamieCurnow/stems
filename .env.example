## Local dev secrets — gitignored. Mirror in `wrangler secret put X --env <env>`
## for deployed envs. Read from `event.context.cloudflare.env`, never process.env.

## Better Auth
# 32 random bytes hex: `npx better-auth secret` or `openssl rand -hex 32`
BETTER_AUTH_SECRET=10a518ebab6ce51b96c2fb1035e65d51986dbe2f0485d2e066780b9f77cf8889
BETTER_AUTH_URL=http://localhost:3000

## Stripe — test mode for dev
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Optional, only if you keep referrals
STRIPE_REFERRAL_COUPON_ID=
# The single secret printed by `stripe listen` covers both webhook URLs in dev.
# In deployed envs each webhook has its own secret.
STRIPE_WEBHOOK_SECRET=
STRIPE_REFERRAL_WEBHOOK_SECRET=

## Email (Resend) — required to send transactional & marketing emails
RESEND_API_KEY=
# Default From — must use a verified Resend domain
MAIL_FROM=Stems <hello@stems.market>
# Public origin used to build absolute links inside emails
PUBLIC_BASE_URL=http://localhost:3000
# Optional: signing secret for Resend webhook (bounce/complaint suppression)
RESEND_WEBHOOK_SECRET=

## Admin gate — shared secret for /api/admin/*, /api/cron/*
# 32 random bytes hex: `openssl rand -hex 32`
ADMIN_API_SECRET=
# Optional comma-separated extra admin emails (extends compiled-in defaults)
ADMIN_EMAILS=

## Analytics — GTM (GA4 + future pixels), PostHog, and server-side GA4.
## The public IDs (GTM / GA4 / PostHog token) are baked as defaults in
## nuxt.config.ts, so nothing is required here for them to work in deployed
## builds. Local `nuxt dev` is skipped by the boot plugin regardless.
## Set these only to OVERRIDE the baked defaults (e.g. point dev/staging at a
## separate GA property or PostHog project):
# NUXT_PUBLIC_GTM_ID=
# NUXT_PUBLIC_GA4_MEASUREMENT_ID=
# NUXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NUXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

## Server-side GA4 Measurement Protocol secret (used by server/utils/analytics.ts
## for events that must arrive off-browser, e.g. referral_landed). Optional —
## the sender soft-fails without it. Set as a wrangler secret in deployed envs:
##   wrangler secret put GA4_API_SECRET --env staging
##   wrangler secret put GA4_API_SECRET --env production
GA4_API_SECRET=
